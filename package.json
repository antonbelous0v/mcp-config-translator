{
	"name": "mcp-config-translator",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm@11.6.2",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "react-router dev",
		"typecheck": "react-router typegen && tsc -b --pretty false",
		"build": "npm run typecheck && react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"lint": "eslint . --cache --max-warnings 0 && npm run lint:styles && npm run lint:architecture",
		"lint:architecture": "node scripts/check-architecture.mjs",
		"lint:fix": "eslint . --cache --fix && npm run lint:styles:fix",
		"lint:styles": "node scripts/check-style-files.mjs && stylelint \"src/**/*.css\"",
		"lint:styles:fix": "stylelint \"src/**/*.css\" --fix && node scripts/check-style-files.mjs",
		"knip": "knip",
		"test": "vitest",
		"test:unit": "vitest run --passWithNoTests",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"check": "npm run lint && npm run test:unit && npm run build && npm run knip",
		"prepare": "husky"
	},
	"dependencies": {
		"@needle-di/core": "^1.2.1",
		"@react-router/node": "^8.3.0",
		"@react-router/serve": "^8.3.0",
		"@reatom/core": "^1001.3.0",
		"@reatom/react": "^1001.0.1",
		"fflate": "^0.8.3",
		"isbot": "^5",
		"jsonc-parser": "^3.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"smol-toml": "^1.8.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.2.0",
		"@axe-core/playwright": "^4.13.0",
		"@boundaries/eslint-plugin": "^7.2.0",
		"@eslint-react/eslint-plugin": "^5.18.6",
		"@playwright/test": "^1.62.1",
		"@react-router/dev": "^8.3.0",
		"@react-router/fs-routes": "^8.3.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"eslint": "^10.9.1",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-react-refresh": "^0.5.5",
		"husky": "^9.1.7",
		"knip": "^6.32.3",
		"lint-staged": "^17.4.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~5.9.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"eslint-plugin-regexp": "3.1.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"eslint --cache --fix",
			"vitest related --run"
		],
		"*.{css,scss}": [
			"stylelint --fix",
			"node scripts/check-style-files.mjs"
		],
		"*.{json,html}": [
			"eslint --fix"
		]
	}
}
